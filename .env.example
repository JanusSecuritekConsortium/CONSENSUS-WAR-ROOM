# Provider endpoints
MSTY_BASE_URL=http://127.0.0.1:11964
MSTY_LLAMA_CPP_BASE_URL=http://localhost:11454
AURELIUS_MSTY_BASE_URL=http://localhost:11454
AURELIUS_PROVIDER=msty
AURELIUS_PROVIDER_FALLBACK_ENABLED=false

# Optional AURELIUS Telegram assistant
TELEGRAM_BOT_TOKEN=
AURELIUS_TELEGRAM_CHAT_ID=

# Provider probing and cache behavior
CONSENSUS_MODEL_CACHE_TTL=120
CONSENSUS_READINESS_RETRY_ATTEMPTS=3
CONSENSUS_READINESS_RETRY_DELAY_SECONDS=2.0

# Optional Riko future implementation
OPENAI_API_KEY=

# Optional real-data layer sources. Credentialed sources stay disabled until
# enabled in config/data_sources.json and configured here.
ACLED_TOKEN=
ACLED_ACCESS_TOKEN=
ACLED_EMAIL=
ACLED_PASSWORD=
FACTAL_API_KEY=
GROUND_NEWS_API_KEY=
IBKR_BASE_URL=
SEARCH_PROVIDER=
SEARCH_API_KEY=

# RSS is configured in config/data_sources.json. Use:
# python tools\probe_rss_feeds.py
# python tools\poll_rss_feeds.py --watch
