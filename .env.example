# Provider endpoints
MSTY_BASE_URL=http://127.0.0.1:11964
MSTY_LLAMA_CPP_BASE_URL=http://localhost:11454
AURELIUS_MSTY_BASE_URL=http://localhost:11454
AURELIUS_PROVIDER=msty
AURELIUS_PROVIDER_FALLBACK_ENABLED=false

# Optional AURELIUS agent execution (install .[agent]; docs/AURELIUS_AGENT.md)
AURELIUS_AGENT_ENABLED=false
AURELIUS_AGENT_BACKGROUND_ENABLED=false
AURELIUS_AGENT_SCHEDULED_ENABLED=false
AURELIUS_AGENT_MAX_ROUNDS=8
AURELIUS_AGENT_MAX_TOOLS=6
AURELIUS_AGENT_CONTEXT_CHARS=24000
AURELIUS_AGENT_RESULT_CHARS=6000
AURELIUS_AGENT_DEADLINE_SECONDS=120
AURELIUS_EXECUTOR_BACKEND=msty
# Empty inherits AURELIUS_MODEL; do not set Ajax until verified support is added.
AURELIUS_EXECUTOR_MODEL=

# Optional AURELIUS Telegram assistant
TELEGRAM_BOT_TOKEN=
AURELIUS_TELEGRAM_CHAT_ID=

# Provider probing and cache behavior
CONSENSUS_MODEL_CACHE_TTL=120
CONSENSUS_READINESS_RETRY_ATTEMPTS=3
CONSENSUS_READINESS_RETRY_DELAY_SECONDS=2.0

# Optional online models for tribunal voters (docs/ONLINE_MODELS.md).
# provider:model. Subscriptions: claude-cli, codex-cli, grok-cli (tool installed and signed in).
# Paid APIs: anthropic, openai, deepseek, xai (key below). Empty keeps the voter local.
CONSENSUS_ONLINE_MODEL_RATIONALIS=
CONSENSUS_ONLINE_MODEL_AETERNUM=
CONSENSUS_ONLINE_MODEL_BELLATOR=
# Backup for every online voter when its own model fails, before the local model.
CONSENSUS_ONLINE_FALLBACK=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# Also used by the optional Riko future implementation.
OPENAI_API_KEY=
# 0 turns every voter back to its local model without removing the settings above.
CONSENSUS_ONLINE_MODELS=1
# 1 also sends the vault brief (50 Agents/Shared Context.md) to online voters.
CONSENSUS_ONLINE_SHARE_PERSONAL=0
CONSENSUS_ONLINE_TOKEN_BUDGET=250000

# Optional guest door for another AI system (docs/GUEST_DOOR.md).
# Make the password with: python -m integrations.guest.server --new-password
CONSENSUS_GUEST_TOKEN=
# 127.0.0.1 = this PC only; a private Tailscale address lets the friend's PC in. Never a public address.
CONSENSUS_GUEST_HOST=127.0.0.1
CONSENSUS_GUEST_PORT=8890
CONSENSUS_GUEST_DAILY_LIMIT=5
# 1 lets guest questions use the online voters (your subscriptions); 0 keeps guests on local models.
CONSENSUS_GUEST_ONLINE=0

# Optional real-data layer sources. Credentialed sources stay disabled until
# enabled in config/data_sources.json and configured here.
ACLED_TOKEN=
ACLED_ACCESS_TOKEN=
ACLED_EMAIL=
ACLED_PASSWORD=
FACTAL_API_KEY=
GROUND_NEWS_API_KEY=
IBKR_BASE_URL=
SEARCH_PROVIDER=
SEARCH_API_KEY=

# RSS is configured in config/data_sources.json. Use:
# python tools\probe_rss_feeds.py
# python tools\poll_rss_feeds.py --watch
AURELIUS_ODYSSEUS_ENABLED=false
AURELIUS_ODYSSEUS_URL=http://127.0.0.1:7000
# Real Odysseus service; read-only investigation mode. See docs/AURELIUS_ODYSSEUS.md.
# Set identifiers through `python -m integrations.odysseus setup` or explicitly here.
# AURELIUS_ODYSSEUS_SESSION=
# AURELIUS_ODYSSEUS_MODEL=
# AURELIUS_ODYSSEUS_ENDPOINT=
# AURELIUS_ODYSSEUS_TOKEN_FILE=G:/CONSENSUS_SYSTEM/_ARBITER/aurelius_odysseus_token.txt
AURELIUS_ODYSSEUS_ALLOW_WEB=false
# readonly requires the isolated Odysseus extension; plan retains legacy checklist behavior.
# AURELIUS_ODYSSEUS_EXECUTION_MODE=readonly
